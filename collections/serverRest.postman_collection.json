				{
					"name": "CT-03_listarUsuarios",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json(); \r",
									"\r",
									"// ========================================\r",
									"// CT-03 - Listar usuários\r",
									"// ========================================\r",
									"\r",
									"//Status Code\r",
									"pm.test(\"Status Code deve ser 200\", () => { \r",
									"    pm.response.to.have.status(200); \r",
									"});\r",
									"\r",
									"//Tempo de resposta\r",
									"pm.test(\"Tempo de resposta inferior a 5 segundos\", () => {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
									"});\r",
									"\r",
									"//Content-type\r",
									"pm.test(\"Resposta deve ser JSON\", () => {\r",
									"    pm.expect(\r",
									"        pm.response.headers.get(\"Content-Type\")\r",
									"    ).to.include(\"application/json\");\r",
									"});\r",
									"\r",
									"//JSON válido\r",
									"pm.test(\"Resposta é um JSON válido\", () => {\r",
									"    pm.expect(response).to.be.an(\"object\");\r",
									"});\r",
									"\r",
									"pm.test(\"Campo quantidade deve existir\", () => {\r",
									"    pm.expect(response).to.have.property(\"quantidade\")\r",
									"})\r",
									"\r",
									"pm.test(\"Campo usuarios deve existir\", () => {\r",
									"    pm.expect(response).to.have.property(\"usuarios\")\r",
									"});\r",
									"\r",
									"pm.test(\"Campo usuarios deve ser um array\", () => {\r",
									"    pm.expect(response.usuarios).to.be.an(\"array\");\r",
									"});\r",
									"\r",
									"//Validar quantidade consistente\r",
									"pm.test(\"Quantidade corresponde ao tamanho da lista\", () => {\r",
									"    pm.expect(response.quantidade).to.eql(response.usuarios.length);\r",
									"});\r",
									"\r",
									"//Validar a estrutura de retorno do primeiro usuário\r",
									"pm.test(\"Todos os usuários possuem estrutura válida\", () => {\r",
									"    response.usuarios.forEach(usuario => {\r",
									"        pm.expect(usuario).to.have.property(\"nome\");\r",
									"        pm.expect(usuario).to.have.property(\"email\");\r",
									"        pm.expect(usuario).to.have.property(\"password\");\r",
									"        pm.expect(usuario).to.have.property(\"administrador\");\r",
									"        pm.expect(usuario).to.have.property(\"_id\");\r",
									"    })\r",
									"})\r",
									"\r",
									"pm.test(\"Todos os campos dos usuários devem ser string\", () => {\r",
									"    response.usuarios.forEach(usuario => {\r",
									"        pm.expect(usuario.nome).to.be.a(\"string\");\r",
									"        pm.expect(usuario.email).to.be.a(\"string\");\r",
									"        pm.expect(usuario.password).to.be.a(\"string\");\r",
									"        pm.expect(usuario.administrador).to.be.a(\"string\");\r",
									"        pm.expect(usuario._id).to.be.a(\"string\");\r",
									"    });\r",
									"});\r",
									"\r",
									"// ====================================\r",
									"// Log para evidência\r",
									"// ====================================\r",
									"console.log(\"======================================\");\r",
									"console.log(\"EVIDÊNCIA CT-03 - LISTAR USUÁRIOS\");\r",
									"console.log(\"======================================\");\r",
									"console.log(`Quantidade de usuários: ${response.quantidade}`);\r",
									"console.log(`Quantidade retornada no array: ${response.usuarios.length}`);\r",
									"console.log(\"Primeiro usuário retornado:\");\r",
									"console.log(response.usuarios[0]);\r",
									"console.log(\"\");\r",
									"console.log(\"Estrutura JSON completa:\");\r",
									"console.log(JSON.stringify(response, null, 2));\r",
									"console.log(\"======================================\");\r",
									""
								],
								"type": "text/javascript"
							}
