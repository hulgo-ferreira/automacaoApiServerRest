	"item": [
		{
			"name": "Login",
			"item": [
				{
					"name": "CT-01_login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json(); \r",
									"const tokenAuthorization = response.authorization;\r",
									"\r",
									"// ========================================\r",
									"// CT 01 - Login com sucesso\r",
									"// ========================================\r",
									"\r",
									"//Status Code\r",
									"pm.test(\"Status Code deve ser 200\", () => { \r",
									"    pm.response.to.have.status(200); \r",
									"});\r",
									"\r",
									"//Tempo de resposta\r",
									"pm.test(\"Tempo de resposta inferior a 5 segundos\", () => {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
									"});\r",
									"\r",
									"//Content-type\r",
									"pm.test(\"Resposta deve ser JSON\", () => {\r",
									"    pm.expect(\r",
									"        pm.response.headers.get(\"Content-Type\")\r",
									"    ).to.include(\"application/json\");\r",
									"});\r",
									"\r",
									"//JSON válido\r",
									"pm.test(\"Resposta é um JSON válido\", () => {\r",
									"    pm.expect(response).to.be.an(\"object\");\r",
									"});\r",
									"\r",
									"pm.test(\"Campo message deve existir\", () => {\r",
									"    pm.expect(response.message).to.exist;\r",
									"});\r",
									"\r",
									"pm.test(\"Campo authorization deve existir\", () => {\r",
									"    pm.expect(response.authorization).to.exist;\r",
									"    pm.expect(response.authorization).to.not.be.empty;\r",
									"});\r",
									"\r",
									"//Mensagem de retorno\r",
									"pm.test(\"Mensagem de sucesso deve estar correta\", function () {\r",
									"    pm.expect(response.message).to.eql(\"Login realizado com sucesso\");\r",
									"});\r",
									"\r",
									"//==================================== \r",
									"// Log para evidência \r",
									"//==================================== \r",
									"\r",
									"console.log(\"======================================\"); \r",
									"console.log(\"EVIDÊNCIA CT 01 - LOGIN\"); \r",
									"console.log(\"======================================\"); \r",
									"console.log(\"Mensagem:\"); \r",
									"console.log(response.message); \r",
									"console.log(\"\"); \r",
									"console.log(\"Token de autorização:\"); \r",
									"console.log(tokenAuthorization); \r",
									"console.log(\"======================================\"); "
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"email\": \"fulano@qa.com\",\r\n  \"password\": \"teste\"\r\n}",
